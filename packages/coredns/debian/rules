#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk
export CGO_ENABLED = 0
export GOTOOLCHAIN = local

%:
	dh $@ --buildsystem=makefile

override_dh_auto_configure:
	test "$(DEB_BUILD_ARCH)" = "$(DEB_HOST_ARCH)"
	go mod download
	go mod verify

override_dh_auto_build:
	go build -mod=readonly -trimpath -buildvcs=false -ldflags='-s -w' -o coredns .

override_dh_auto_test:
	go test -mod=readonly ./core/... ./plugin/file ./plugin/forward ./plugin/reload ./plugin/acl ./plugin/view

override_dh_auto_install:
	install -D -m0755 coredns debian/coredns/usr/bin/coredns
	install -D -m0644 debian/Corefile debian/coredns/etc/coredns/Corefile

override_dh_auto_clean:
	rm -f coredns

override_dh_installsystemd:
	dh_installsystemd --no-start

# The Go linker already strips this static binary.
override_dh_dwz:
override_dh_strip:
