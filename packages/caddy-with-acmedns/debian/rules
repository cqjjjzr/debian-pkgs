#!/usr/bin/make -f

%:
	dh $@ --buildsystem=makefile

override_dh_auto_configure:

override_dh_auto_build:
	nu --no-config-file ./build-caddy.nu
	mkdir -p man
	./caddy-build/out/caddy manpage --directory man
	./caddy-build/out/caddy completion bash > caddy-completion

override_dh_auto_test:
	./caddy-build/out/caddy list-modules | grep -x dns.providers.acmedns
	./caddy-build/out/caddy validate --config debian/Caddyfile --adapter caddyfile

override_dh_auto_install:
	install -D -m0755 caddy-build/out/caddy debian/caddy-with-acmedns/usr/bin/caddy
	install -D -m0644 debian/Caddyfile debian/caddy-with-acmedns/etc/caddy/Caddyfile
	install -D -m0644 debian/index.html debian/caddy-with-acmedns/usr/share/caddy/index.html
	install -D -m0644 caddy-completion debian/caddy-with-acmedns/usr/share/bash-completion/completions/caddy
	install -D -m0644 debian/caddy.service debian/caddy-with-acmedns/usr/lib/systemd/system/caddy.service
	install -D -m0644 debian/caddy-api.service debian/caddy-with-acmedns/usr/lib/systemd/system/caddy-api.service

override_dh_auto_clean:
	rm -rf caddy-build man caddy-completion

override_dh_installsystemd:
	dh_installsystemd --no-start --no-enable

# The Go linker already strips this static binary.
override_dh_dwz:
override_dh_strip:
